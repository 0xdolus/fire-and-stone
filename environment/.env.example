# Fire & Stone — Environment variable names only.
#
# This file documents WHICH variables exist. It contains NO real values.
# Real values live in:
#   - Local development: an untracked .env file (see environment/README.md)
#   - CI: GitHub Actions secrets
#   - Mobile builds: EAS secrets / EAS environment variables
#   - Cloud Functions: Firebase Functions config / Secret Manager
#
# Never commit a filled-in .env file. .env* (except this file) is gitignored.

# ---------------------------------------------------------------------------
# Firebase — client (public) config
# These are safe to ship in a client bundle; they identify the project,
# they are not secrets. Distinct values per environment (dev/staging/prod).
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Emulator Suite — local development
# ---------------------------------------------------------------------------
USE_FIREBASE_EMULATORS=true
FIREBASE_EMULATOR_HOST=localhost
FIRESTORE_EMULATOR_PORT=8080
AUTH_EMULATOR_PORT=9099
STORAGE_EMULATOR_PORT=9199
FUNCTIONS_EMULATOR_PORT=5001
EMULATOR_UI_PORT=4000

# ---------------------------------------------------------------------------
# Expo / EAS
# ---------------------------------------------------------------------------
EAS_PROJECT_ID=
EXPO_PUBLIC_APP_ENV=development

# ---------------------------------------------------------------------------
# Admin/Kitchen web app
# ---------------------------------------------------------------------------
ADMIN_WEB_FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Cloud Functions — names only. Values live in Functions secret storage,
# never in this repo, never in agent context.
# ---------------------------------------------------------------------------
# FUTURE_PAYMENT_PROVIDER_API_KEY   (not used in V1 — Cash on Delivery only)
# FUTURE_PAYMENT_WEBHOOK_SECRET     (not used in V1 — Cash on Delivery only)

# ---------------------------------------------------------------------------
# Never put in this file or any tracked file:
#   - Firebase service-account JSON / Admin SDK private keys
#   - GitHub Personal Access Tokens
#   - Payment provider secrets
#   - App Store / Google Play credentials
#   - Real customer data or production database exports
# ---------------------------------------------------------------------------
